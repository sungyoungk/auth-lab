<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.sungyoung.authlab.auth.mapper.RefreshTokenMapper">

    <insert id="insert">
        INSERT INTO refresh_token (member_id, token, expires_at)
        VALUES (#{memberId}, #{token}, #{expiresAt})
    </insert>

    <select id="findByToken" resultType="com.sungyoung.authlab.auth.dto.RefreshTokenDto">
        SELECT id, member_id, token, expires_at
        FROM refresh_token
        WHERE token = #{token}
    </select>

    <delete id="deleteByToken">
        DELETE FROM refresh_token WHERE token = #{token}
    </delete>

    <delete id="deleteByMemberId">
        DELETE FROM refresh_token WHERE member_id = #{memberId}
    </delete>

</mapper>