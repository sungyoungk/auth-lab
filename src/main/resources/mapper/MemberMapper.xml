<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.sungyoung.authlab.member.mapper.MemberMapper">

    <select id="findById" resultType="com.sungyoung.authlab.member.dto.MemberDto">
        SELECT
            id,
            login_id,
            name,
            role
        FROM member
        WHERE id = #{id}
    </select>

</mapper>